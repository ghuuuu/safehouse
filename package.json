{
  "name": "safehouse",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev --port 4021",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:setup": "node scripts/db-setup.mjs",
    "db:migrate": "npm run db:setup && drizzle-kit migrate",
    "db:seed": "node scripts/seed-dev.mjs",
    "key:make": "node scripts/make-key.mjs",
    "backup": "vite-node scripts/backup.ts",
    "backup:drill": "vite-node scripts/drill.ts",
    "restore": "vite-node scripts/restore.ts"
  },
  "dependencies": {
    "@react-router/node": "^7.18.2",
    "@react-router/serve": "^7.18.2",
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.36",
    "mrz": "^5.0.2",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.2",
    "sharp": "^0.35.5",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^7.18.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.18.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
