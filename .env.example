# Copy this file to .env for local development.
# .env is git-ignored and must never be committed — see .gitignore.

# The owner connection: creates tables, runs migrations, bypasses row-level
# security. Migrations and seeding use it. The application never does.
DATABASE_URL=postgres://safehouse:safehouse-dev@127.0.0.1:5435/safehouse

# What the running application connects as. This role owns nothing, so every
# permission policy applies to it — that is the point of it existing (D11).
APP_DB_PASSWORD=safehouse-app-dev
APP_DATABASE_URL=postgres://safehouse_app:safehouse-app-dev@127.0.0.1:5435/safehouse

# What the sign-in code connects as. It can read and write accounts, sessions
# and users, because checking a password requires that. It has no privileges at
# all on records, documents or files (D24).
AUTH_DB_PASSWORD=safehouse-auth-dev
AUTH_DATABASE_URL=postgres://safehouse_auth:safehouse-auth-dev@127.0.0.1:5435/safehouse

# Signs session cookies. Change this and every signed-in session ends.
# Generate one for a real deployment: openssl rand -base64 32
BETTER_AUTH_SECRET=development-secret-not-for-real-use

# The address the browser reaches this server on. Cookies are bound to it.
BETTER_AUTH_URL=http://localhost:4021

# Used by docker compose to create the database owner.
# Change every password above before the vault holds anything real.
POSTGRES_PASSWORD=safehouse-dev
