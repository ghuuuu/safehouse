# Copy this file to .env for local development.
# .env is git-ignored and must never be committed — see .gitignore.

# Local development, talking to the Postgres container over loopback.
DATABASE_URL=postgres://safehouse:safehouse-dev@127.0.0.1:5432/safehouse

# Used by docker compose to create the database user.
# Change this before the vault holds anything real.
POSTGRES_PASSWORD=safehouse-dev
